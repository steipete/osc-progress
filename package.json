{
  "name": "osc-progress",
  "version": "0.3.0",
  "description": "Tiny TypeScript helper for OSC 9;4 terminal progress sequences.",
  "keywords": [
    "cli",
    "ghostty",
    "osc",
    "progress",
    "terminal",
    "wezterm",
    "windows-terminal"
  ],
  "homepage": "https://github.com/steipete/osc-progress#readme",
  "bugs": {
    "url": "https://github.com/steipete/osc-progress/issues"
  },
  "license": "MIT",
  "author": "Peter Steinberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steipete/osc-progress.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "typecheck": "tsgo -p tsconfig.build.json --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm format:check && oxlint --deny-warnings src tests",
    "lint:fix": "pnpm format && oxlint --fix src tests",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.25.0"
}
